<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MyShop - Product Showcase</title>
<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f6fa;
            transition: background 0.3s, color 0.3s;
        }

        .dark-mode {
            background: #121212;
            color: white;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, background 0.3s;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .btn-custom {
            background: #007bff;
            color: white;
            border: none;
            transition: 0.3s;
        }

        .btn-custom:hover {
            background: #0056b3;
        }

        footer {
            background: #222;
            color: white;
            padding: 15px;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <nav class="navbar navbar-dark bg-dark px-3">
        <span class="navbar-brand">MyShop</span>
        <button class="btn btn-light" onclick="toggleMode()">Toggle Dark Mode</button>
    </nav>

    <!-- Counter -->
    <div class="container text-center mt-3">
        <h5>Total Purchases: <span id="counter">0</span></h5>
        <button class="btn btn-warning" onclick="resetCounter()">Reset Counter</button>
    </div>

    <!-- Product Section -->
    <div class="container mt-4">
        <div class="row" id="productContainer">
            <!-- Cards inserted by JS -->
        </div>
    </div>

    <footer>
        © 2025 MyShop
    </footer>

    <script>
        /* =========================
        Section A: Variables & Datatypes
        ========================= */

        // Q1
        let productName = "Smartphone";
        let productPrice = 1500;
        let productAvailable = true;

        // Q2
        console.log(typeof productName);
        console.log(typeof productPrice);
        console.log(typeof productAvailable);

        // Q3
        let prices = [500, 1200, 1500];
        console.log(prices);

        // Q4
        let product = {
            name: "Smartphone",
            price: 1500,
            category: "Electronics",
            rating: 4.5
        };

        /* =========================
        Section B: Operators
        ========================= */

        // Q6
        console.log(product.price > 1000);

        // Q7
        console.log(productAvailable && product.price < 2000);

        // Q8
        let stockStatus = productAvailable ? "In Stock" : "Out of Stock";

        // Q9
        let discount;
        switch (product.category) {
            case "Electronics":
                discount = 10;
                break;
            case "Fashion":
                discount = 20;
                break;
            default:
                discount = 5;
        }

        // Q10
        let productType = product.price > 1000 ? "Premium Product" : "Budget Product";

        /* =========================
        Section C: Functions
        ========================= */

        // Q11
        function showAlert(name) {
            alert("Thank you for your interest in " + name + "!");
        }

        // Q12
        function calculateDiscount(price, discount) {
            return price - (price * discount / 100);
        }

        // Q13
        function updatePrice(id, newPrice) {
            document.getElementById(id).innerText = "₹" + newPrice;
        }

        // Q14
        function changeButton(btn) {
            btn.innerText = "Added to Cart";
            btn.disabled = true;
        }

        // Q15
        let counter = 0;
        function resetCounter() {
            counter = 0;
            document.getElementById("counter").innerText = counter;
        }

        /* =========================
        Section D: Constructor & OOP
        ========================= */

        // Q16
        function Product(name, price, category) {
            this.name = name;
            this.price = price;
            this.category = category;

            // Q18, Q19
            this.getDetails = function () {
                return this.name + " - ₹" + this.price;
            };
        }

        // Q17
        let p1 = new Product("Smartphone", 1500, "Electronics");
        let p2 = new Product("T-Shirt", 800, "Fashion");
        let p3 = new Product("Headphones", 1200, "Electronics");

        let products = [p1, p2, p3];

        /* =========================
        Section E: DOM & Events
        ========================= */

        // Q20: Display objects dynamically
   function displayProducts() {
        let container = document.getElementById("productContainer");
        container.innerHTML = ""; // clear previous content

        products.forEach((prod, index) => {
            let finalPrice = calculateDiscount(prod.price, discount);

            container.innerHTML += `
        <div class="col-md-4 mb-4">
            <div class="card p-3 product-card">

                <img src="${prod.image}" class="card-img-top">

                <div class="card-body text-center">
                    <h5>${prod.name}</h5>
                    <p>${productType}</p>
                    <p id="price${index}">₹${finalPrice}</p>
                    <p>${stockStatus}</p>
                    <button class="btn btn-custom buyBtn">Buy Now</button>
                </div>
            </div>
        </div>
        `;
        });

        attachEvents();
    }


        // Q21, Q22, Q23
        function attachEvents() {
            let buttons = document.querySelectorAll(".buyBtn");

            buttons.forEach(btn => {
                btn.onclick = function () {
                    counter++;
                    document.getElementById("counter").innerText = counter;

                    showAlert("Product");
                    changeButton(this);
                };
            });
        }

        // Q24 Dark Mode
        function toggleMode() {
            document.body.classList.toggle("dark-mode");
        }

        // Q25 Hover effect using JS
        document.addEventListener("mouseover", function (e) {
            if (e.target.closest(".product-card")) {
                e.target.closest(".product-card").style.background = "#f0f8ff";
            }
        });

        document.addEventListener("mouseout", function (e) {
            if (e.target.closest(".product-card")) {
                e.target.closest(".product-card").style.background = "white";
            }
        });

        // Load products
        displayProducts();
    </script>

</body>

</html>
