<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyShop - Product Showcase</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            transition: background 0.3s, color 0.3s;
        }

        /* Card Styling */
        .product-card {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .product-card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .product-card img {
            height: 200px;
            object-fit: cover;
        }

        .price {
            font-weight: 600;
            color: #0d6efd;
            font-size: 1.2rem;
        }

        /* Custom Button */
        .btn-buy {
            background-color: #0d6efd;
            color: white;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        .btn-buy:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }

        /* Dark Mode */
        .dark-mode {
            background-color: #121212;
            color: #ffffff;
        }

        .dark-mode .card {
            background-color: #1e1e1e;
            color: white;
        }

        footer {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">MyShop</a>
            <button class="btn btn-light btn-sm" onclick="toggleDarkMode()">Toggle Dark Mode</button>
        </div>
    </nav>

    <!-- Header -->
    <header class="text-center py-4">
        <h1 class="fw-bold">Featured Products</h1>
        <p class="text-muted">Explore our latest collection</p>
    </header>

    <!-- Counter -->
    <div class="text-center mb-3">
        <p class="fw-semibold">Products clicked: <span id="counter">0</span></p>
    </div>

    <!-- Product Section -->
    <section class="container pb-5">
        <div class="row g-4">

            <!-- Product 1 -->
            <div class="col-md-4">
                <div class="card product-card h-100">
                    <img src="https://data:image/jpeg;base64,"
                        class="card-img-top" alt="Product 1">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Wireless Headphones</h5>
                        <p class="card-text">High-quality wireless headphones with noise cancellation and long battery
                            life.</p>
                        <p class="price">₹2,999</p>
                        <button class="btn btn-buy mt-auto" onclick="buyProduct('Wireless Headphones')">Buy Now</button>
                    </div>
                </div>
            </div>

            <!-- Product 2 -->
            <div class="col-md-4">
                <div class="card product-card h-100">
                    <img src="https://https://encrypted-tbn1.gstatic.com/images?q=tbn:ANd9GcSAycUqX9ZRx36LHvu_zThJfX-P-EgiFJgDn0p0BZa59e4pvkA9"
                        class="card-img-top" alt="Product 2">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Smart Watch</h5>
                        <p class="card-text">Track your fitness, monitor heart rate, and stay connected with this
                            stylish smartwatch.</p>
                        <p class="price">₹4,499</p>
                        <button class="btn btn-buy mt-auto" onclick="buyProduct('Smart Watch')">Buy Now</button>
                    </div>
                </div>
            </div>

            <!-- Product 3 -->
            <div class="col-md-4">
                <div class="card product-card h-100">
                    <img src="https://data:image/jpeg;base64," class="card-img-top" alt="Product 3">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Bluetooth Speaker</h5>
                        <p class="card-text">Portable speaker with deep bass, waterproof design, and 12-hour playtime.
                        </p>
                        <p class="price">₹1,999</p>
                        <button class="btn btn-buy mt-auto" onclick="buyProduct('Bluetooth Speaker')">Buy Now</button>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="text-center py-3">
        <p class="mb-0">© 2025 MyShop. All rights reserved.</p>
    </footer>

    <!-- JavaScript -->
    <script>
        let count = 0;

        function buyProduct(productName) {
            count++;
            document.getElementById('counter').textContent = count;
            alert(`Thank you for your interest in ${productName}!`);
        }

        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
        }
    </script>

</body>

</html>
