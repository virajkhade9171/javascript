<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Railway Booking</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<link rel="stylesheet" href="style.css">
</head>
<body>

<!-- Header -->
<header class="bg-dark text-white p-3 shadow">
  <div class="container d-flex justify-content-between">
    <h4><i class="bi bi-train-front"></i> Indian Railway Booking</h4>
    <nav>
      <a href="#" class="text-white me-3">Home</a>
      <a href="#" class="text-white me-3">Book Ticket</a>
      <a href="#" class="text-white me-3">PNR Status</a>
      <a href="#" class="text-white">Contact</a>
    </nav>
  </div>
</header>

<!-- Banner -->
<section class="banner d-flex align-items-center justify-content-center text-white">
  <h1 class="display-5 fw-bold">Book Your Journey 🚆</h1>
</section>

<!-- Booking Form -->
<div class="container my-5">
  <div class="card shadow-lg p-4 booking-card">

    <h4 class="mb-3 text-center">Train Ticket Booking</h4>

    <form id="bookingForm">

      <div class="row g-3">

        <div class="col-md-6">
          <label class="form-label">Source</label>
          <input type="text" id="source" class="form-control required">
        </div>

        <div class="col-md-6">
          <label class="form-label">Destination</label>
          <input type="text" id="destination" class="form-control required">
        </div>

        <div class="col-md-6">
          <label>Journey Date</label>
          <input type="date" id="date" class="form-control">
        </div>

        <div class="col-md-6">
          <label>Class</label>
          <select id="class" class="form-select">
            <option value="">Select</option>
            <option value="SL">Sleeper</option>
            <option value="3A">3AC</option>
            <option value="2A">2AC</option>
            <option value="1A">1AC</option>
          </select>
        </div>

        <div class="col-md-6">
          <label>Quota</label>
          <select id="quota" class="form-select">
            <option>General</option>
            <option>Tatkal</option>
            <option>Ladies</option>
          </select>
        </div>

        <div class="col-md-6">
          <label>Passengers</label>
          <input type="number" id="passengers" min="1" max="6" class="form-control">
        </div>

      </div>

      <div class="text-center mt-4">
        <button type="submit" id="searchBtn" class="btn btn-danger px-5">
          Search Trains
        </button>
        <button type="button" id="resetBtn" class="btn btn-secondary ms-2">Reset</button>
      </div>

      <div id="error" class="text-danger mt-3 text-center"></div>
    </form>
  </div>
</div>

<!-- Train List -->
<div class="container my-4" id="trainSection" style="display:none;">
  <h4>Available Trains</h4>
  <table class="table table-hover">
    <thead class="table-dark">
      <tr>
        <th>Select</th>
        <th>Train</th>
        <th>Time</th>
        <th>Seats</th>
      </tr>
    </thead>
    <tbody id="trainList"></tbody>
  </table>
</div>

<!-- Summary -->
<div class="container my-4" id="summary" style="display:none;"></div>

<!-- Footer -->
<footer class="bg-dark text-white text-center p-3">
  <small>Indian Railways demo project. For educational use only.</small>
</footer>

<!-- Modal -->
<div class="modal fade" id="confirmModal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5>Confirm Booking</h5>
      </div>
      <div class="modal-body">Confirm ticket booking?</div>
      <div class="modal-footer">
        <button class="btn btn-success" id="confirmBooking">Confirm</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="script.js"></script>
</body>
</html>
